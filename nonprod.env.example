PPROF_ENABLED=false
LOG_LEVEL=INFO
LOG_CONSOLE=true
LOG_FILE=false
LOG_JSON=true
LOG_DIR=./logs
LOG_FILE_NAME=server.log
LOG_FILE_MAX_MB=200
LOG_FILE_MAX_BACKUPS=2
LOG_FILE_MAX_AGE=31
AUDIO_S3_BUCKET_NAME=your-s3-bucket
AUDIO_S3_BUCKET_PREFIX=audio/
AUDIO_S3_REGION=us-east-2
AUDIO_SQS_URL=https://sqs.us-east-2.amazonaws.com/your-account-id/your-queue-name
SHEET_S3_BUCKET_NAME=your-s3-bucket
SHEET_S3_BUCKET_PREFIX=dropbox_sheetmusic/
SHEET_S3_REGION=us-east-2
SHOWS_S3_BUCKET_NAME=your-s3-bucket
SHOWS_S3_BUCKET_PREFIX=shows/
SHOWS_S3_REGION=us-east-2
HOME_PAGE_IMAGE_S3_URL=https://your-s3-bucket.s3.us-east-2.amazonaws.com/path/to/resume.pdf
PERSONAL_WEBSITE_PASSWORD=changeme
DROPBOX_APP_KEY=your-dropbox-app-key
DROPBOX_APP_SECRET=your-dropbox-app-secret
DROPBOX_REFRESH_TOKEN=your-dropbox-refresh-token
DROPBOX_SHEET_MUSIC_FOLDER=
